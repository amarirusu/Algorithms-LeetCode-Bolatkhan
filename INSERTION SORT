# ==========================================================
# 1. АЛГОРИТМ INSERTION SORT (СОРТИРОВКА ВСТАВКАМИ)
# ==========================================================
def insertion_sort(A):
    """
    Реализация по книге Т. Кормена.
    Сортирует массив, последовательно вставляя каждый элемент 
    в уже отсортированную левую часть.
    """
    for j in range(1, len(A)):
        key = A[j]  # Элемент, который мы "выбираем из кучи"
        i = j - 1
        # Сдвигаем элементы, которые больше нашего ключа
        while i >= 0 and A[i] > key:
            A[i + 1] = A[i]
            i -= 1
        # Вставляем ключ на его законное место
        A[i + 1] = key

# ==========================================================
# 2. АЛГОРИТМ MERGE SORT (СОРТИРОВКА СЛИЯНИЕМ)
# ==========================================================
def merge(A, p, q, r):
    """
    Вспомогательная процедура для объединения двух частей.
    """
    # Создаем временные списки (подход через срезы для оптимизации)
    L = A[p : q + 1]
    R = A[q + 1 : r + 1]
    
    i = j = 0  # Указатели для левой и правой частей
    k = p      # Указатель для записи в основной массив
    
    # Сравниваем элементы и сливаем их в порядке возрастания
    while i < len(L) and j < len(R):
        if L[i] <= R[j]:
            A[k] = L[i]
            i += 1
        else:
            A[k] = R[j]
            j += 1
        k += 1
        
    # Если в одном из списков остались элементы, дописываем их
    while i < len(L):
        A[k] = L[i]
        i += 1
        k += 1
    while j < len(R):
        A[k] = R[j]
        j += 1
        k += 1

def merge_sort(A, p, r):
    """
    Рекурсивная функция, реализующая принцип 'разделяй и властвуй'.
    """
    if p < r:
        q = (p + r) // 2  # Точка разделения массива пополам
        merge_sort(A, p, q)      # Сортируем левую половину
        merge_sort(A, q + 1, r)  # Сортируем правую половину
        merge(A, p, q, r)        # Сливаем результаты
